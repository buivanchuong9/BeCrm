# === App ===
NODE_ENV=development
PORT=3000
API_BASE_PATH=/api/v1
# Swagger version always follows package.json; there is no separate env override.

# === CORS / public URL ===
FRONTEND_ORIGINS=http://localhost:5173
APP_PUBLIC_URL=http://localhost:3000
REQUEST_BODY_LIMIT=1mb
TRUST_PROXY_HOPS=0
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=100

# === Database (Prisma / PostgreSQL 16) ===
# docker-compose.prod.yml initializes PostgreSQL from these values on the
# first start of a new volume. Changing them later does not rewrite an existing
# database role/database.
POSTGRES_USER=app
POSTGRES_PASSWORD=REPLACE_WITH_URL_SAFE_RANDOM_VALUE
POSTGRES_DB=dermahealth
# Local host process:
DATABASE_URL=postgresql://app:dev@127.0.0.1:5442/dermahealth?schema=public
# Production container equivalent:
# DATABASE_URL=postgresql://app:REPLACE_WITH_URL_SAFE_RANDOM_VALUE@postgres:5432/dermahealth?schema=public

# === Redis (BullMQ, throttling, short-lived idempotency support) ===
REDIS_URL=redis://127.0.0.1:6389

# === Auth: access/refresh tokens ===
# Generate a dev keypair, e.g.: openssl genpkey -algorithm RSA -out access_private.pem -pkeyopt rsa_keygen_bits:2048
# Paste PEM contents with literal \n newlines, or point CI/secret-manager at file-based secrets in real environments.
ACCESS_TOKEN_PRIVATE_KEY=REPLACE_WITH_PEM_PRIVATE_KEY
ACCESS_TOKEN_PUBLIC_KEY=REPLACE_WITH_PEM_PUBLIC_KEY
ACCESS_TOKEN_TTL=10m
REFRESH_TOKEN_TTL=30d
REFRESH_TOKEN_TTL_NOT_REMEMBERED=24h
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# === Password / field-level protection ===
PASSWORD_PEPPER=REPLACE_WITH_RANDOM_DEV_VALUE
FIELD_ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_BASE64_KEY

# === S3-compatible storage (MinIO locally) ===
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=dermahealth-private-dev
S3_ACCESS_KEY=REPLACE_WITH_MINIO_ACCESS_KEY
S3_SECRET_KEY=REPLACE_WITH_MINIO_SECRET_KEY
S3_FORCE_PATH_STYLE=true
LOCAL_STORAGE_PATH=/app/storage

# === Mail (Mailpit locally) ===
MAIL_FROM=no-reply@dermahealth.example.test
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=

# === SMS (disabled by default; safe default per spec section 47) ===
SMS_PROVIDER=disabled
SMS_API_KEY=

# === AI adapter ===
AI_PROVIDER=deterministic
AI_MODEL_VERSION=derma-vision-2.4.0
AI_SERVICE_URL=http://localhost:8000
AI_TIMEOUT_MS=30000
AI_MAX_RESPONSE_BYTES=5000000
AI_MAX_CONCURRENT_CASES=1
AI_QUALITY_MIN_SCORE=0.55
AI_MIN_TOP_PROBABILITY=0.60
AI_MIN_PROBABILITY_MARGIN=0.15
AI_MIN_BRIGHTNESS=0.12
AI_MAX_BRIGHTNESS=0.95
AI_MIN_BLUR_VARIANCE=0.001
AI_APPROVED_PREPROCESSING_VERSION=imagenet-eval-224-v1
# Shared only between the NestJS API and the private AI container.
AI_API_KEY=REPLACE_WITH_RANDOM_INTERNAL_SECRET
# Ubuntu production: NVIDIA GPU index exposed to the AI container.
AI_GPU_DEVICE=0
# Override only when the Ubuntu NVIDIA driver requires another supported CUDA wheel channel.
PYTORCH_INDEX_URL=https://download.pytorch.org/whl/cu126

# === Observability ===
LOG_LEVEL=info
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# === DermaTimeline image-analysis adapter ===
# unavailable (default): real patients get null quality/no image metrics, exactly like today.
# demo: force-selects the deterministic demo adapter for every comparison. Refused in production
# (env.validation.ts) — only for local/CI demoing. Normally leave unset; the demo adapter is
# instead gated per-lesion by the derma_timeline_demo_analysis feature flag.
DERMA_TIMELINE_ANALYSIS_ADAPTER=unavailable
